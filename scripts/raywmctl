#!/usr/bin/env python3
"""Small client for RayWM IPC v1 (Python standard library only)."""
import argparse
import json
import os
import socket
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--socket", default=os.environ.get("RAYWM_SOCKET"))
    parser.add_argument("method", choices=("windows", "outputs", "workspaces", "perf", "focus", "workspace_activate", "window_workspace", "subscribe"))
    parser.add_argument("arguments", nargs="*")
    args = parser.parse_args()
    if not args.socket:
        runtime = os.environ.get("XDG_RUNTIME_DIR")
        display = os.environ.get("WAYLAND_DISPLAY")
        if not runtime or not display:
            parser.error("XDG_RUNTIME_DIR and WAYLAND_DISPLAY are required, or use --socket")
        args.socket = os.path.join(runtime, "raywm-" + display + ".sock")
    params = {}
    if args.method == "subscribe":
        params["events"] = args.arguments
    elif args.method in ("focus", "workspace_activate", "window_workspace"):
        names = ("window", "workspace") if args.method == "window_workspace" else (("window",) if args.method == "focus" else ("workspace",))
        if len(args.arguments) != len(names):
            parser.error("expected " + " ".join(names))
        try:
            params = dict(zip(names, map(int, args.arguments)))
        except ValueError:
            parser.error("IDs must be integers")
    elif args.arguments:
        parser.error("queries do not take positional arguments")
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(5)
        client.connect(args.socket)
        stream = client.makefile("rb")
        request_id = 0
        result = []
        while True:
            request_id += 1
            client.sendall((json.dumps({"v": 1, "id": request_id, "method": args.method, "params": params}) + "\n").encode())
            while True:
                line = stream.readline(131073)
                if not line or len(line) > 131072:
                    raise RuntimeError("disconnected or oversized response")
                response = json.loads(line)
                if response.get("id") == request_id:
                    break
                print(json.dumps(response), flush=True)
            if not response.get("ok"):
                raise RuntimeError(response.get("err", "request failed"))
            if args.method in ("windows", "outputs", "workspaces"):
                page = response["result"]
                result.extend(page["items"])
                if page["next"] is not None:
                    params["offset"] = page["next"]
                    continue
                print(json.dumps(result, ensure_ascii=False))
            elif args.method == "subscribe":
                client.settimeout(None)
                while True:
                    line = stream.readline(131073)
                    if not line or len(line) > 131072:
                        return
                    print(json.dumps(json.loads(line), ensure_ascii=False), flush=True)
            elif args.method == "perf":
                print(json.dumps(response["result"], indent=2))
            else:
                print(json.dumps(response["result"]))
            break


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, ValueError) as error:
        print("raywmctl:", error, file=sys.stderr)
        sys.exit(1)
